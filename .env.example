# Copia este archivo a .env.local y llena los valores. .env.local NUNCA se sube a GitHub.

# Supabase → tu proyecto → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La llave SECRETA (empieza con sb_secret_). Solo vive en el servidor.
SUPABASE_SECRET_KEY=
# Opcional: la llave publicable, solo para que `npm run diagnostico` compruebe que NO puede leer tus datos.
SUPABASE_PUBLISHABLE_KEY=

# Contraseña para entrar a la app (mínimo 12 caracteres).
ARMARIO_PASSWORD=
# Firma de la sesión. Genera uno con: openssl rand -hex 32
ARMARIO_SESSION_SECRET=

# Opcional: la asesora de imagen (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=
# Opcional: otro modelo para la asesora (por defecto claude-opus-5).
# ASESORA_MODELO=

# Opcional: para que un bot (Telegram u otro) hable con la asesora. Genera uno con: openssl rand -hex 32
ARMARIO_API_SECRET=

# Opcional: zona horaria (por defecto America/Mexico_City).
# ARMARIO_TZ=America/Bogota
